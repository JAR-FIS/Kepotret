# Browser-safe configuration only. Never place credentials, tokens, or secrets here.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only backend origin used by the Next.js external API rewrite.
KEPOTRET_API_ORIGIN=http://localhost:8080

# Optional error telemetry. Events remain disabled unless explicitly enabled and a public Sentry DSN is supplied.
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=

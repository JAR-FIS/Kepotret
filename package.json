{
  "name": "kepotret-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Kepotret V1 frontend foundation",
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "engines": {
    "node": "24.21.0",
    "pnpm": ">=10.27.0 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "api:generate": "orval --config ./orval.config.ts",
    "api:check": "node ./scripts/check-openapi.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "11.0.0",
    "lucide-react": "1.48.0",
    "motion": "13.4.2",
    "next": "16.3.6",
    "next-intl": "4.14.6",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "26.1.0",
    "orval": "8.36.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
